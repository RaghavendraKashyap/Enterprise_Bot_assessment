# Source: debug-lab/templates/worker.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker
  labels:
    app: worker
    app.kubernetes.io/part-of: eb-debug-lab
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: debug-lab-2.0.0
spec:
  replicas: 1
  selector:
    matchLabels:
      app: worker
  template:
    metadata:
      labels:
        app: worker
        app.kubernetes.io/part-of: eb-debug-lab
        app.kubernetes.io/managed-by: Helm
        helm.sh/chart: debug-lab-2.0.0
    spec:
      volumes:
        - name: app-cache
          emptyDir: {}
      containers:
        - name: worker
          image: "docker.io/ebinterview/eb-debug-app:1.0.1"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
          volumeMounts:
            - name: app-cache
              mountPath: /var/cache/app
          env:
            - name: APP_MODE
              value: "worker"
            - name: APP_NAME
              value: "worker"
            - name: PORT
              value: "8080"
            - name: VERSION
              value: "2.0.0"
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 5
            timeoutSeconds: 3
          securityContext:
            runAsNonRoot: false
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            limits:
              cpu: 200m
              memory: 128Mi
            requests:
              cpu: 50m
              memory: 64Mi

