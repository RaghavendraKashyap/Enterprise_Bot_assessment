FROM node:22.16.0-alpine AS stage1

WORKDIR /solution

COPY package*.json ./

RUN npm ci --omit=dev

FROM node:22.16.0-alpine AS stage2

WORKDIR /app

RUN addgroup -S appuser && \
    adduser -S appuser -G appuser

COPY --from=stage1 /solution/node_modules ./node_modules
COPY --chown=appuser:appuser package*.json ./
COPY --chown=appuser:appuser src ./src

USER appuser

EXPOSE 8080

CMD ["node", "src/solution.js"]